# Copy this file to .env and add ONE key. The first key found is used, in this order: Gemini, OpenAI, Claude.
GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (comma-separated = fallbacks tried in order)
# CUSTOMER_MODEL=gemini-3.5-flash-lite
# REVIEW_MODEL=gemini-3.8-flash,gemini-3.5-flash
# LIVE_MODEL=gemini-3.8-live   (the voice model for live calls)
# PORT=3000
